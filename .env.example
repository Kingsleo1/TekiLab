# TekiLab server environment. Never put private credentials in VITE_ variables.
# Copy this file to .env locally; use Vercel Environment Variables when hosting.
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_VERIFICATION_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=default_keyspace
TEKILAB_ASTRA_RECORDS_COLLECTION=tekilab_records
# Generate a random secret of at least 32 characters for hosted site settings saves.
TEKILAB_ADMIN_ACCESS_KEY=
# Keep writes held until the database collection and schema have been reviewed.
TEKILAB_ENABLE_ASTRA_WRITES=false
TEKILAB_PREVIEW_MODE=true
PUBLIC_SITE_URL=https://tekilab.vercel.app
# Optional server AI and diagnostic instrument integration.
GEMINI_API_KEY=
TEKILAB_INSTRUMENT_WEBHOOK_SECRET=
# Providers require a production backend and their own approved credentials.
FLW_SECRET_KEY=
TEKILAB_ENABLE_NOTIFICATIONS=false
RESEND_API_KEY=
TEKILAB_EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RESULT_TEMPLATE=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en
