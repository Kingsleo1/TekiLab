# ==============================================================================
# TEKIPHARM MULTI-TENANT SaaS PLATFORM — ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATASTAX ASTRA DB CONFIGURATION (PRIMARY CLOUD DATABASE - CQL / REST API)
# ------------------------------------------------------------------------------
# Obtain these 3 values from your DataStax Astra Portal (https://astra.datastax.com):
#   1. Open your Astra Database ("Tekipharm") -> Overview tab
#   2. Copy your "API Endpoint" (e.g., https://<db-id>-<region>.apps.astra.datastax.com)
#   3. Click "Generate Token" (Role: Database Administrator) -> Copy the token starting with "AstraCS:..."
#   4. Keyspace name: "default_keyspace"

VITE_ASTRA_DB_API_ENDPOINT="https://dd0b5ae4-d60e-47ea-ba03-1360309991ec-us-east-2.apps.astra.datastax.com"
VITE_ASTRA_DB_APPLICATION_TOKEN="AstraCS:your_generated_application_token_here"
VITE_ASTRA_DB_KEYSPACE="default_keyspace"

# Server-side proxy mirrors (optional - falls back to VITE_ASTRA_DB_* automatically)
ASTRA_DB_API_ENDPOINT="https://dd0b5ae4-d60e-47ea-ba03-1360309991ec-us-east-2.apps.astra.datastax.com"
ASTRA_DB_APPLICATION_TOKEN="AstraCS:your_generated_application_token_here"
ASTRA_DB_KEYSPACE="default_keyspace"

# ------------------------------------------------------------------------------
# 2. GEMINI AI & APPLICATION HOSTING
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for server-side Gemini AI API calls (Rapid Anomaly Check & Lab Assistant).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional shared secret for Diagnostic Instrument Webhook Hub authentication
TEKILAB_INSTRUMENT_WEBHOOK_SECRET=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 3. OPTIONAL LEGACY SUPABASE FALLBACK
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
